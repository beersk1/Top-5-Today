{
  "name": "top-5-today",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently --names server,website --prefix-colors blue,magenta \"npm:dev:server\" \"npm:dev:website\"",
    "dev:server": "tsx watch server/index.ts",
    "dev:website": "vite",
    "build": "tsc --noEmit && vite build",
    "start": "tsx server/index.ts --serve-website",
    "typecheck": "tsc --noEmit",
    "format": "prettier --write .",
    "reset-data": "tsx server/reset.ts"
  },
  "dependencies": {
    "@tanstack/react-query": "^5.104.1",
    "express": "^5.2.1",
    "lucide-react": "^1.52.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "wouter": "^3.13.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "concurrently": "^10.0.5",
    "prettier": "^3.9.9",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vite": "^8.3.3"
  }
}
